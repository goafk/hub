#!/bin/sh
# Resolves symlinks so the shim works from ~/.local/bin.
SELF="$0"
while [ -L "$SELF" ]; do
  LINK=$(readlink "$SELF")
  case "$LINK" in /*) SELF="$LINK" ;; *) SELF="$(dirname "$SELF")/$LINK" ;; esac
done
DIR=$(cd "$(dirname "$SELF")/.." && pwd)
exec node --no-warnings "$DIR/src/cli.ts" "$@"
